generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTE_SENT
  PAYMENT_PENDING
  CONFIRMED
  PRODUCTION
  READY
  SHIPPED
  COMPLETED
  CANCELLED
}

enum InquiryType {
  PRODUCT
  CUSTOM
}

model Admin {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  isVisible Boolean @default(true)
  position Int @default(0)
  products Product[]
  imageId String?
  image Media? @relation("CategoryImage", fields: [imageId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String
  price Decimal @db.Decimal(10, 2)
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  images ProductImage[]
  variants ProductVariant[]
  collections ProductCollection[]
  isCustomizable Boolean @default(true)
  isFeatured Boolean @default(false)
  isActive Boolean @default(true)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([categoryId, isActive])
}

model Collection {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  isVisible Boolean @default(true)
  position Int @default(0)
  products ProductCollection[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id String @id @default(cuid())
  productId String
  mediaId String
  alt String?
  position Int @default(0)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id])
  @@unique([productId, mediaId])
}

model ProductVariant {
  id String @id @default(cuid())
  productId String
  sizes String[] @default([])
  colors String[] @default([])
  printPositions String[] @default([])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductCollection {
  productId String
  collectionId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  @@id([productId, collectionId])
}

model WebsiteSection {
  id String @id @default(cuid())
  page String
  type String
  content Json
  isVisible Boolean @default(true)
  position Int @default(0)
  updatedAt DateTime @updatedAt
  @@index([page, isVisible, position])
}

model Media {
  id String @id @default(cuid())
  publicId String @unique
  url String
  alt String?
  folder String?
  createdAt DateTime @default(now())
  productImages ProductImage[]
  categoryImages Category[] @relation("CategoryImage")
}

model Inquiry {
  id String @id @default(cuid())
  reference String @unique
  type InquiryType
  status InquiryStatus @default(NEW)
  customerName String
  whatsapp String
  productType String?
  quantity Int?
  size String?
  color String?
  printPosition String?
  designDescription String?
  additionalNotes String?
  referenceMediaId String?
  productId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model SiteSettings {
  id String @id @default("default")
  brandName String @default("NAQSH")
  tagline String @default("Where Ideas Take Form.")
  heroTitle String @default("Where ideas take form.")
  heroText String @default("Custom printed pieces, made with care.")
  heroImageUrl String?
  whatsappNumber String?
  productMessage String @default("Hello, I am interested in this NAQSH product.")
  customMessage String @default("Hello, I have submitted a custom design request to NAQSH.")
  phone String?
  email String?
  address String?
  hours String?
  siteTitle String @default("NAQSH | Where Ideas Take Form")
  metaDescription String @default("Custom DTF printing and merchandise by NAQSH.")
  updatedAt DateTime @updatedAt
}

model BrandSetting {
  id String @id @default("default")
  siteName String @default("NAQSH")
  tagline String @default("Where Ideas Take Form.")
  logoUrl String?
  faviconUrl String?
  updatedAt DateTime @updatedAt
}

model WhatsAppSetting {
  id String @id @default("default")
  phone String?
  defaultMessage String @default("Hello, I would like to know more about NAQSH.")
  productMessage String @default("Hello, I am interested in this NAQSH product.\n\nProduct: {product}\nSize: {size}\nColor: {color}\nPrint position: {position}")
  customMessage String @default("Hello, I submitted NAQSH inquiry {reference}.")
  updatedAt DateTime @updatedAt
}

model ContactSetting {
  id String @id @default("default")
  phone String?
  email String?
  address String?
  hours String?
  instagram String?
  facebook String?
  updatedAt DateTime @updatedAt
}

model SeoSetting {
  id String @id @default("default")
  page String @unique
  title String?
  description String?
  updatedAt DateTime @updatedAt
}
